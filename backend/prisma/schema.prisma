generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("member")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Member {
  id             Int      @id @default(autoincrement())
  firstName      String
  lastName       String
  email          String?
  phone          String?
  address        String?
  dateOfBirth    String?
  gender         String?
  joinDate       String
  status         String   @default("Active")
  membershipType String   @default("Full")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("members")
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  category    String   @default("Service")
  startDate   String
  endDate     String
  startTime   String?
  endTime     String?
  venue       String?
  capacity    Int      @default(0)
  registered  Int      @default(0)
  status      String   @default("Upcoming")
  speaker     String?
  notes       String?
  reminders   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

model Giving {
  id            Int      @id @default(autoincrement())
  memberId      Int?
  memberName    String
  amount        Float
  category      String   @default("Tithe")
  paymentMethod String   @default("Cash")
  date          String
  receiptNumber String?
  notes         String?
  transactionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("givings")
}

model MpesaTransaction {
  id               String   @id @default(cuid())
  transactionId    String
  phone            String
  amount           Float
  type             String   @default("general")
  description      String?
  status           String   @default("pending")
  merchantRequestId String?
  checkoutRequestId String?
  resultCode       String?
  resultDesc       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("mpesa_transactions")
}

model Sermon {
  id          Int      @id @default(autoincrement())
  title       String
  series      String?
  preacher    String
  date        String
  description String?
  scripture   String?
  notes       String?
  audioUrl    String?
  duration    String?
  status      String   @default("published")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("sermons")
}

model PrayerRequest {
  id          Int      @id @default(autoincrement())
  memberName  String
  title       String
  description String
  status      String   @default("active")
  assignedTo  String?
  answeredDate String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("prayer_requests")
}

model Budget {
  id          Int      @id @default(autoincrement())
  category    String
  allocated   Float
  spent       Float    @default(0)
  period      String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("budgets")
}

model Pledge {
  id          Int      @id @default(autoincrement())
  memberId    Int?
  memberName  String
  amount      Float
  category    String
  startDate   String
  endDate     String?
  paid        Float    @default(0)
  balance     Float    @default(0)
  status      String   @default("active")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pledges")
}

model Notification {
  id          Int      @id @default(autoincrement())
  type        String
  subject     String
  message     String
  recipient   String
  status      String   @default("pending")
  sentAt      String
  channel     String   @default("email")
  eventId     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notifications")
}

model Media {
  id          Int      @id @default(autoincrement())
  name        String
  type        String
  mimeType    String
  size        Int
  data        String   @db.Text
  uploadedAt  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("media")
}